# Zentro backend environment variables
# Copy to backend/.env and adjust.
# NOTE: no .env file on disk = SQLite local dev (zero-config).

# ── Core ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────
# LOCAL DEV  : leave DATABASE_URL unset → Django ORM runs on SQLite (db.sqlite3).
# PRODUCTION : set DATABASE_URL to a PostgreSQL URL → Django ORM switches engine
#              automatically. No code/model changes needed; SQLAlchemy-free.
#   postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Optional PostgreSQL knob (only used when DATABASE_URL is set):
DB_SSLMODE=require
DB_CONN_MAX_AGE=600

# Alternative (no DATABASE_URL) — explicit Postgres config:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=zentro
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── Channels / cache / background tasks ────────────────────────────────────
# Leave unset for local dev (in-memory channel layer + eager tasks).
# Set to a redis:// URL in production (WebSockets, cache, Celery broker).
REDIS_URL=

# ── Static / media ─────────────────────────────────────────────────────────
USE_S3_STORAGE=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=

# ── Frontend / CORS / CSRF ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8082
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000

# ── AI / integrations ──────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Web Push (PWA) ─────────────────────────────────────────────────────────
# Generate once via: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Email ──────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── SMS / OTP (phone verification) ─────────────────────────────────────────
# console = free dev backend (logs the code; debug_code returned when DEBUG).
#   SMS_BACKEND=console
# twilio  = paid per-SMS (international ~$0.04–0.12). Needs:
#   SMS_BACKEND=twilio
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_MESSAGING_SERVICE_SID=   (or TWILIO_PHONE_NUMBER=)
# vonage  = paid per-SMS alternative:
#   SMS_BACKEND=vonage
#   VONAGE_API_KEY=
#   VONAGE_API_SECRET=
#   VONAGE_BRAND=Zentro
SMS_BACKEND=console
OTP_TTL_MINUTES=10

# ── Google OAuth ("Continue with Google") ──────────────────────────────────
# Comma-separated OAuth web client IDs accepted for POST /api/auth/google/.
# Must match the frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_IDS=
# ── Stage 1: Install dependencies ─────────────────────────────────────────────
FROM oven/bun:1 AS deps

WORKDIR /app

# Copy dependency manifests first (better layer caching)
COPY package.json bun.lock ./

RUN bun install

# ── Stage 2: Build the TanStack Start app ─────────────────────────────────────
FROM oven/bun:1 AS builder

WORKDIR /app

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code and config files
COPY package.json bun.lock vite.config.ts tsconfig.json ./
COPY src/ ./src/
COPY public/ ./public/

# Build-time environment variable for the Django API URL
ARG VITE_DJANGO_API_BASE_URL=http://localhost:8000/api
ENV VITE_DJANGO_API_BASE_URL=${VITE_DJANGO_API_BASE_URL}

RUN bun run build

# ── Stage 3: Production runtime ───────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

# Copy built output
COPY --from=builder /app/.output ./.output

# Copy node_modules (only production dependencies needed at runtime)
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
